# Aura local environment (copy values into .env.local — never commit keys)
# The signaling server loads .env.local then .env (see server/env.ts).

# WebSocket signaling
SIGNALING_PORT=3100
SIGNALING_HOST=0.0.0.0

# Speech-to-text provider: auto | deepgram | mock
# auto = Deepgram when DEEPGRAM_API_KEY is set, otherwise the mock engine.
STT_PROVIDER=auto

# Deepgram (Phase 2.1) — get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Engine defaults (Phase 2.3 language, 2.1 model)
STT_MODEL=nova-3
STT_LANGUAGE=en

# Boosted vocabulary, comma-separated (Phase 2.4)
STT_KEYWORDS=

# Ambient sound classification (Phase 4.1-4.2): auto | hf | mock
# auto = HuggingFace AudioSet when HF_TOKEN is set, otherwise the mock engine.
AMBIENT_PROVIDER=auto

# HuggingFace (Phase 4.2) — token with "Inference Providers" permission
HF_TOKEN=
AMBIENT_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593
AMBIENT_WINDOW_S=4
AMBIENT_THRESHOLD=0.3
AMBIENT_COOLDOWN_S=20

# Server-side TTS via ElevenLabs (Phase 3.1)
# Without a key the app falls back to browser speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# Interpreter relay (Phase 5). Demo mode auto-matches a virtual interpreter
# when no human is online, preserving the out-of-box flow.
VRS_DEMO_MODE=true
VRS_DEMO_DELAY_S=8
# JSONL session log (metadata only, never audio/video). "off" disables.
VRS_LOG_FILE=data/vrs-sessions.jsonl

# Supabase Auth + Postgres (Phase 6). Without these, auth/cloud features
# no-op gracefully and everything stays local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TURN for restrictive NATs (Phase 8.5, comma-separated URLs)
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Logging (Phase 8.3): level=debug|info|warn|error, format=text|json
LOG_LEVEL=info
LOG_FORMAT=text
