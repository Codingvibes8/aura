# Aura local environment (copy values into .env.local — never commit keys)
# The signaling server loads .env.local then .env (see server/env.ts).

# WebSocket signaling
SIGNALING_PORT=3100
SIGNALING_HOST=0.0.0.0

# Speech-to-text provider: auto | deepgram | mock
# auto = Deepgram when DEEPGRAM_API_KEY is set, otherwise the mock engine.
STT_PROVIDER=auto

# Deepgram (Phase 2.1) — get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Engine defaults (Phase 2.3 language, 2.1 model)
STT_MODEL=nova-3
STT_LANGUAGE=en

# Boosted vocabulary, comma-separated (Phase 2.4)
STT_KEYWORDS=

# Server-side TTS via ElevenLabs (Phase 3.1)
# Without a key the app falls back to browser speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
